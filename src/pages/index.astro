---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout title="Maison Eglantine — Élégance artisanale">
  <section class="hero">
    <div class="hero-inner reveal">
      <div class="eyebrow" style="color:#fff">Maison Eglantine</div>
      <h1>L’élégance, autrement.</h1>
      <p>Entre héritage et modernité. Des pièces pensées et confectionnées avec soin en Algérie.</p>
      <a class="btn hero-btn" href="#collections">Découvrir la collection</a>
    </div>
  </section>

  <section id="eglantine" class="brand-statement">
    <div class="brand-statement-inner">
      <div class="brand-editorial reveal">
        <div class="brand-kicker"><span>Notre histoire</span></div>
        <h2 class="brand-title">
          <span>Maison</span>
          <em>Eglantine</em>
        </h2>
        <div class="brand-manifesto">
          <p>Eglantine est une jeune marque algérienne<br class="desktop-break" /> qui n’a qu’une seule obsession :<br class="desktop-break" /> créer du beau et créer algérien.</p>
          <p>Laissez-vous charmer par nos collections<br class="desktop-break" /> qui sublimeront chaque journée de votre quotidien.</p>
        </div>
        <a class="brand-cta" href="#collections">
          <span>Découvrir nos collections</span>
          <span aria-hidden="true">⟶</span>
        </a>
      </div>
      <div class="brand-visual">
        <img src={base + 'images/home/maison-story.png'} alt="Bouquet d’églantines dans un vase artisanal" loading="lazy" data-parallax data-speed="-0.02" />
        <div class="brand-visual-copy" aria-label="Créer du beau, créer algérien">
          <span>Créer<br/>du beau</span>
          <i aria-hidden="true"></i>
          <span>Créer<br/>algérien</span>
        </div>
      </div>
    </div>
  </section>

  <section id="collections" class="section">
    <div class="eyebrow">Les univers</div>
    <div class="category-grid" style="margin-top:28px">
      <a class="category-card category-traditionnel" href={base + 'traditionnel'}>
        <div>
          <div class="eyebrow" style="color:#fff">Collection</div>
          <h3>Traditionnel</h3>
          <p>L’héritage réinterprété.</p>
        </div>
      </a>
      <a class="category-card category-pret" href={base + 'pret-a-porter'}>
        <div>
          <div class="eyebrow" style="color:#fff">Collection</div>
          <h3>Prêt-à-Porter</h3>
          <p>L’élégance au quotidien.</p>
        </div>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="eyebrow">La sélection</div>
    <h2 class="section-title">Nos pièces</h2>
    <p class="section-intro">Une sélection pensée et confectionnée avec soin.</p>
    <div class="product-grid">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="section craft">
    <div class="craft-media">
      <img src={base + 'images/home/savoir-faire.webp'} alt="Détail de confection Maison Eglantine" loading="lazy" />
    </div>
    <div class="craft-copy reveal">
      <div class="eyebrow">Notre savoir-faire</div>
      <h2 class="section-title">Fait main. Ici.</h2>
      <p>Chaque pièce Maison Eglantine est imaginée et confectionnée dans nos ateliers en Algérie. Des matières choisies avec soin, un travail minutieux et cette attention portée aux détails qui rend chaque création singulière.</p>
      <div class="pill-row">
        <span class="pill">Savoir-faire</span>
        <span class="pill">Confection locale</span>
        <span class="pill">Fait main</span>
        <span class="pill">Petites séries</span>
      </div>
    </div>
  </section>

  <section class="section testimonials">
    <div class="eyebrow" style="color:#c9c7c0">Ce qu’elles en disent</div>
    <blockquote class="quote">“Encore plus beau qu’en photo. Les finitions sont magnifiques.”</blockquote>
    <p>— Sarah, Oran</p>
  </section>

  <script is:inline>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) entry.target.classList.add('is-visible');
      });
    }, { threshold: .15 });
    document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));

    const parallaxSection = document.querySelector('.brand-statement');
    const parallaxItems = document.querySelectorAll('[data-parallax]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
    let ticking = false;

    function updateParallax() {
      if (!parallaxSection || reduceMotion.matches || window.innerWidth <= 900) return;
      const rect = parallaxSection.getBoundingClientRect();
      const progress = (window.innerHeight / 2) - (rect.top + rect.height / 2);
      parallaxItems.forEach((item) => {
        const speed = Number(item.dataset.speed || 0);
        const offset = Math.max(-32, Math.min(32, progress * speed));
        item.style.setProperty('--parallax-y', `${offset}px`);
      });
      ticking = false;
    }

    window.addEventListener('scroll', () => {
      if (!ticking) {
        requestAnimationFrame(updateParallax);
        ticking = true;
      }
    }, { passive: true });
    updateParallax();
  </script>
</BaseLayout>
