---
import BaseLayout from '../layouts/BaseLayout.astro';
import { deliveryRates } from '../data/delivery';
---
<BaseLayout title="Commander — Maison Eglantine">
  <section class="checkout-page">
    <div class="eyebrow">Finaliser</div>
    <h1 class="section-title">Votre commande</h1>

    <div style="display:grid;grid-template-columns:1.2fr .8fr;gap:7vw" class="checkout-shell">
      <form id="checkout-form">
        <p id="checkout-error" class="checkout-error" role="alert" hidden></p>
        <div class="form-grid">
          <label class="field full">Nom et prénom<input name="name" required /></label>
          <label class="field">Téléphone<input name="phone" required inputmode="tel" /></label>
          <label class="field">Wilaya
            <select name="wilaya" id="wilaya" required>
              <option value="">Sélectionner</option>
              {deliveryRates.map(({ wilaya }) => <option value={wilaya}>{wilaya}</option>)}
            </select>
          </label>
          <label class="field">Commune<input name="commune" required /></label>
          <label class="field full">Adresse complète<input name="address" required /></label>
          <fieldset class="field full delivery-method">
            <legend>Mode de livraison</legend>
            <label><input type="radio" name="delivery-method" value="home" required /> À domicile</label>
            <label><input type="radio" name="delivery-method" value="desk" required /> Stop-desk</label>
          </fieldset>
          <label class="field full">Remarque (facultatif)<textarea name="note"></textarea></label>
        </div>
        <label style="display:flex;gap:10px;margin:24px 0;font-size:13px">
          <input type="checkbox" required style="width:auto" />
          <span>Je confirme l’exactitude de mes coordonnées et j’accepte les conditions de vente.</span>
        </label>
        <button class="btn btn-dark" type="submit">Confirmer ma commande</button>
      </form>

      <aside class="checkout-summary">
        <div class="eyebrow">Récapitulatif</div>
        <div id="checkout-items" style="margin-top:18px"></div>
        <div class="summary-line"><span>Sous-total</span><span id="checkout-subtotal">0 DA</span></div>
        <div class="summary-line"><span>Livraison</span><span id="delivery-fee">À confirmer</span></div>
        <div class="summary-line total"><span>Total</span><span id="checkout-total">0 DA</span></div>
        <p style="font-size:13px;color:var(--muted)">Paiement en espèces à la livraison.</p>
      </aside>
    </div>
  </section>

  <script define:vars={{ deliveryRates }}>
    const KEY = 'maison-eglantine-cart';
    const format = (n) => new Intl.NumberFormat('fr-DZ').format(n) + ' DA';
    const cart = JSON.parse(localStorage.getItem(KEY) || '[]');
    const subtotal = cart.reduce((s, i) => s + i.price * i.quantity, 0);

    document.getElementById('checkout-items').innerHTML = cart.map(i =>
      `<div style="padding:10px 0;border-bottom:1px solid var(--line)">
        <strong>${i.name}</strong><br/>
        <span style="font-size:13px;color:var(--muted)">${i.color} · ${i.size} · Qté ${i.quantity}</span>
        <span style="float:right">${format(i.price * i.quantity)}</span>
      </div>`
    ).join('');

    document.getElementById('checkout-subtotal').textContent = format(subtotal);
    document.getElementById('checkout-total').textContent = format(subtotal);

    const wilayaInput = document.getElementById('wilaya');
    const deliveryFee = document.getElementById('delivery-fee');
    const total = document.getElementById('checkout-total');
    let selectedRate = null;

    function updateDelivery() {
      const method = document.querySelector('input[name="delivery-method"]:checked')?.value;
      selectedRate = deliveryRates.find((rate) => rate.wilaya === wilayaInput.value) || null;
      const fee = selectedRate && method ? selectedRate[method] : null;
      deliveryFee.textContent = fee === null ? 'À sélectionner' : format(fee);
      total.textContent = format(subtotal + (fee || 0));
    }

    wilayaInput.addEventListener('change', updateDelivery);
    document.querySelectorAll('input[name="delivery-method"]').forEach((input) => input.addEventListener('change', updateDelivery));

    const form = document.getElementById('checkout-form');
    const errorBox = document.getElementById('checkout-error');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const method = document.querySelector('input[name="delivery-method"]:checked')?.value;
      const fee = selectedRate && method ? selectedRate[method] : 0;
      if (!cart.length || !selectedRate || !method) {
        errorBox.textContent = 'Merci de vérifier votre panier, votre wilaya et votre mode de livraison.';
        errorBox.hidden = false;
        return;
      }
      const submitButton = form.querySelector('button[type="submit"]');
      const data = new FormData(form);
      errorBox.hidden = true;
      submitButton.disabled = true;
      submitButton.textContent = 'Enregistrement…';
      try {
        const response = await fetch('/api/orders', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({
            name: data.get('name'), phone: data.get('phone'), wilaya: data.get('wilaya'), commune: data.get('commune'),
            address: data.get('address'), note: data.get('note'), deliveryMethod: method, cart
          })
        });
        const order = await response.json();
        if (!response.ok) throw new Error(order.error || 'La commande n’a pas pu être enregistrée.');
      localStorage.setItem('maison-eglantine-last-order', JSON.stringify({
        orderNumber: order.orderNumber, subtotal: order.subtotal, cart, deliveryFee: order.deliveryFee, total: order.total,
        wilaya: wilayaInput.value, deliveryMethod: method === 'desk' ? 'Stop-desk' : 'À domicile'
      }));
      localStorage.removeItem(KEY);
      window.location.href = '/confirmation';
      } catch (error) {
        errorBox.textContent = error.message || 'La commande n’a pas pu être enregistrée. Réessayez dans un instant.';
        errorBox.hidden = false;
        submitButton.disabled = false;
        submitButton.textContent = 'Confirmer ma commande';
      }
    });
  </script>

  <style>
    .delivery-method{border:0;padding:0}.delivery-method legend{font-size:13px;margin-bottom:10px}.delivery-method label{display:inline-flex;align-items:center;gap:8px;margin:0 22px 0 0;font-size:14px}.delivery-method input{width:auto}
    .checkout-error{margin:0 0 20px;padding:12px 14px;border:1px solid #b4514b;background:#fff6f4;color:#782d28;font-size:14px}
    @media(max-width:800px){.checkout-shell{grid-template-columns:1fr!important}}
  </style>
</BaseLayout>
