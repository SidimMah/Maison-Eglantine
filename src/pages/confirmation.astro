---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<BaseLayout title="Commande confirmée — Maison Eglantine">
  <section class="simple-page confirmation-page">
    <div class="confirmation-mark">✦</div>
    <div class="eyebrow">Maison Eglantine</div>
    <h1 class="section-title">Merci pour votre commande.</h1>
    <p>Votre commande a bien été enregistrée.</p>
    <p id="order-number" class="confirmation-number"></p>
    <p id="order-total" class="confirmation-total"></p>
    <div class="confirmation-actions">
      <a class="btn btn-dark" href={base}>Retour à l’accueil</a>
      <a class="btn" href={base + 'traditionnel'}>Découvrir la collection</a>
    </div>
  </section>
  <script is:inline>
    const order = JSON.parse(localStorage.getItem('maison-eglantine-last-order') || 'null');
    if (order) {
      document.getElementById('order-number').textContent = 'Commande ' + order.orderNumber;
      document.getElementById('order-total').textContent =
        'Total à régler à la livraison : ' + new Intl.NumberFormat('fr-DZ').format(order.subtotal) + ' DA';
    }
  </script>
</BaseLayout>
