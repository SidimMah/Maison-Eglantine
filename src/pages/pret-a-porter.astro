---
import BaseLayout from '../layouts/BaseLayout.astro';
import { products, assetUrl, formatPrice } from '../data/products';
const product = products.find((p) => p.slug === 'summer-elegance')!;
const colors = ['Fuchsia', 'Noir', 'Orange'];
const base = import.meta.env.BASE_URL.endsWith('/') ? import.meta.env.BASE_URL : import.meta.env.BASE_URL + '/';
---
<BaseLayout title="Prêt-à-Porter — Maison Eglantine">
  <section class="summer-collection">
    <header class="summer-heading">
      <div class="eyebrow">Maison Eglantine · Prêt-à-Porter</div>
      <h1>Summer Elegance</h1>
      <p>Une robe fluide. Trois couleurs. Votre allure.</p>
    </header>
    <div class="summer-colors">
      {colors.map((color) => (
        <a class:list={['summer-look', { 'summer-look-main': color === 'Noir' }]} href={base + 'produit/' + product.slug + '?couleur=' + encodeURIComponent(color)}>
          <div class="summer-image">
            <img src={assetUrl(product.images[color][0])} alt={'Summer Elegance — ' + color} loading="eager" />
          </div>
          <span class="summer-color"><i class:list={['color-dot', color.toLowerCase()]} aria-hidden="true"></i>{color}<span aria-hidden="true">⟶</span></span>
        </a>
      ))}
    </div>
    <div class="summer-details">
      <div class="price">{formatPrice(product.price)}</div>
      <p>Robe-chemise légère, ceinture ajustable et coupe décontractée.</p>
      <span class="summer-sizes">Tailles S · M · L</span>
      <a class="btn btn-dark" href={base + 'produit/' + product.slug + '?couleur=Noir'}>Découvrir la robe</a>
    </div>
  </section>
</BaseLayout>
