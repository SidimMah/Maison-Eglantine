---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductCard from '../components/ProductCard.astro';
import { products } from '../data/products';
const items = products.filter((p) => p.category === 'pret-a-porter');
---
<BaseLayout title="Prêt-à-Porter — Maison Eglantine">
  <section class="collection-hero">
    <div class="eyebrow">Maison Eglantine</div>
    <h1 class="section-title">Prêt-à-Porter</h1>
    <p>L’élégance au quotidien.</p>
  </section>
  <section class="collection-grid">
    <div class="product-grid">
      {items.map((product) => <ProductCard product={product} />)}
    </div>
  </section>
</BaseLayout>
