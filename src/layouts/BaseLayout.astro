---
import '../styles/global.css';
const {
  title = 'Maison Eglantine',
  description = 'Maison Eglantine — confection artisanale de vêtements féminins en Algérie.',
  noindex = false,
  image = '/images/home/hero-desktop.webp',
  structuredData
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = new URL(image, Astro.site).href;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:locale" content="fr_DZ" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Maison Eglantine" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>Maison Eglantine</a>
      <nav aria-label="Navigation principale">
        <a href={base}>Accueil</a>
        <a href={base + '#eglantine'}>Eglantine</a>
        <a href={base + 'pret-a-porter'}>Prêt-à-Porter</a>
        <a href={base + 'traditionnel'}>Traditionnel</a>
      </nav>
      <a class="cart-link" href={base + 'panier'} aria-label="Ouvrir le panier" data-cart-toggle>
        <span class="cart-icon-wrap"><img src={base + 'images/icons/panier.png'} alt="" aria-hidden="true" /></span>
        <span>Panier</span> <span id="cart-count">0</span>
      </a>
    </header>
    <main>
      <slot />
    </main>
    <div class="cart-drawer-backdrop" data-cart-close></div>
    <aside class="cart-drawer" aria-label="Panier" aria-hidden="true">
      <div class="cart-drawer-head">
        <div>
          <p class="drawer-kicker">Votre sélection</p>
          <h2>Votre panier</h2>
        </div>
        <button class="drawer-close" type="button" data-cart-close aria-label="Fermer le panier">×</button>
      </div>
      <div class="cart-drawer-items" data-cart-drawer-items></div>
      <div class="cart-drawer-empty" data-cart-drawer-empty>Votre panier est encore vide.</div>
      <div class="cart-drawer-footer">
        <div class="drawer-subtotal"><span>Sous-total</span><strong data-cart-drawer-total>0 DA</strong></div>
        <p>Livraison calculée à l’étape suivante.</p>
        <a class="btn drawer-checkout" href={base + 'commande'}>Passer commande <span aria-hidden="true">⟶</span></a>
        <a class="drawer-view-cart" href={base + 'panier'}>Voir le panier complet</a>
      </div>
    </aside>
    <footer class="site-footer">
      <div class="footer-brand">
        <div class="wordmark footer-wordmark">Maison Eglantine</div>
        <p>Confection artisanale<br />et élégance algérienne.</p>
        <div class="social-links" aria-label="Réseaux sociaux">
          <a href="https://www.instagram.com/la.maison.eglantine/" target="_blank" rel="noreferrer" aria-label="Instagram Maison Eglantine">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" class="social-fill"/></svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61560847380174" target="_blank" rel="noreferrer" aria-label="Facebook Maison Eglantine">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h2.7l.4-3H14V8.1c0-.9.3-1.6 1.7-1.6H17V3.8c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10H8v3h2.8v8H14Z" class="social-fill"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-links">
        <p class="footer-label">Découvrir</p>
        <a href={base + '#eglantine'}>La Maison</a>
        <a href={base + 'pret-a-porter'}>Prêt-à-Porter</a>
        <a href={base + 'traditionnel'}>Traditionnel</a>
      </div>
      <div class="footer-links footer-service">
        <p class="footer-label">Service client</p>
        <a href={base + 'livraison'}>Livraison & retours</a>
        <a href={base + 'contact'}>Nous contacter</a>
        <span>Paiement à la livraison</span>
      </div>
      <div class="footer-bottom">
        <p>Créé avec soin, en Algérie.</p>
        <p>© 2026 Maison Eglantine</p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const KEY = 'maison-eglantine-cart';
        const drawer = document.querySelector('.cart-drawer');
        const backdrop = document.querySelector('.cart-drawer-backdrop');
        const items = document.querySelector('[data-cart-drawer-items]');
        const empty = document.querySelector('[data-cart-drawer-empty]');
        const total = document.querySelector('[data-cart-drawer-total]');
        const count = document.getElementById('cart-count');
        const format = (value) => new Intl.NumberFormat('fr-FR').format(value) + ' DA';
        const escape = (value = '') => String(value).replace(/[&<>'"]/g, char => ({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[char]));
        const getCart = () => JSON.parse(localStorage.getItem(KEY) || '[]');
        const saveCart = (cart) => localStorage.setItem(KEY, JSON.stringify(cart));

        const renderCart = () => {
          const cart = getCart();
          const quantity = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
          if (count) count.textContent = quantity;
          if (items) items.innerHTML = cart.map((item, index) => `
            <article class="drawer-item">
              <div class="drawer-item-media">${item.image ? `<img src="${escape(item.image)}" alt="${escape(item.name)}">` : ''}</div>
              <div class="drawer-item-copy"><strong>${escape(item.name)}</strong><span>${escape(item.color)} · Taille ${escape(item.size)}</span><span>Qté ${item.quantity}</span><b>${format(item.price * item.quantity)}</b></div>
              <button type="button" data-drawer-remove="${index}" aria-label="Retirer ${escape(item.name)}">×</button>
            </article>`).join('');
          if (empty) empty.hidden = cart.length > 0;
          if (total) total.textContent = format(cart.reduce((sum, item) => sum + item.price * item.quantity, 0));
        };
        const openDrawer = () => { renderCart(); drawer?.classList.add('is-open'); backdrop?.classList.add('is-open'); drawer?.setAttribute('aria-hidden', 'false'); document.body.classList.add('drawer-open'); };
        const closeDrawer = () => { drawer?.classList.remove('is-open'); backdrop?.classList.remove('is-open'); drawer?.setAttribute('aria-hidden', 'true'); document.body.classList.remove('drawer-open'); };
        document.querySelector('[data-cart-toggle]')?.addEventListener('click', (event) => { event.preventDefault(); openDrawer(); });
        document.querySelectorAll('[data-cart-close]').forEach(button => button.addEventListener('click', closeDrawer));
        items?.addEventListener('click', (event) => { const button = event.target.closest('[data-drawer-remove]'); if (!button) return; const cart = getCart(); cart.splice(Number(button.dataset.drawerRemove), 1); saveCart(cart); renderCart(); window.dispatchEvent(new CustomEvent('maison-eglantine:cart-updated')); });
        window.addEventListener('maison-eglantine:cart-updated', openDrawer);
        window.addEventListener('storage', renderCart);
        window.addEventListener('keydown', event => { if (event.key === 'Escape') closeDrawer(); });
        renderCart();
      })();
    </script>
  </body>
</html>
