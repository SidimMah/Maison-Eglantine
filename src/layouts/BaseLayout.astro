---
import '../styles/global.css';
const {
  title = 'Maison Eglantine',
  description = 'Maison Eglantine — confection artisanale en Algérie.'
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base}>Maison Eglantine</a>
      <nav aria-label="Navigation principale">
        <a href={base}>Accueil</a>
        <a href={base + '#eglantine'}>Eglantine</a>
        <a href={base + 'pret-a-porter'}>Prêt-à-Porter</a>
        <a href={base + 'traditionnel'}>Traditionnel</a>
      </nav>
      <a class="cart-link" href={base + 'panier'} aria-label="Panier">Panier <span id="cart-count">0</span></a>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-brand">
        <div class="wordmark footer-wordmark">Maison Eglantine</div>
        <p>Confection artisanale<br />et élégance algérienne.</p>
        <div class="social-links" aria-label="Réseaux sociaux">
          <a href="https://www.instagram.com/la.maison.eglantine/" target="_blank" rel="noreferrer" aria-label="Instagram Maison Eglantine">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".9" class="social-fill"/></svg>
          </a>
          <a href="https://www.facebook.com/profile.php?id=61560847380174" target="_blank" rel="noreferrer" aria-label="Facebook Maison Eglantine">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14 21v-8h2.7l.4-3H14V8.1c0-.9.3-1.6 1.7-1.6H17V3.8c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4V10H8v3h2.8v8H14Z" class="social-fill"/></svg>
          </a>
        </div>
      </div>
      <div class="footer-links">
        <p class="footer-label">Découvrir</p>
        <a href={base + '#eglantine'}>La Maison</a>
        <a href={base + 'pret-a-porter'}>Prêt-à-Porter</a>
        <a href={base + 'traditionnel'}>Traditionnel</a>
      </div>
      <div class="footer-links footer-service">
        <p class="footer-label">Service client</p>
        <a href={base + 'livraison'}>Livraison & retours</a>
        <a href={base + 'contact'}>Nous contacter</a>
        <span>Paiement à la livraison</span>
      </div>
      <div class="footer-bottom">
        <p>Créé avec soin, en Algérie.</p>
        <p>© 2026 Maison Eglantine</p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const cart = JSON.parse(localStorage.getItem('maison-eglantine-cart') || '[]');
        const count = cart.reduce((sum, item) => sum + (item.quantity || 1), 0);
        const target = document.getElementById('cart-count');
        if (target) target.textContent = count;
      })();
    </script>
  </body>
</html>
